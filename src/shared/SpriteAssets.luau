-- Direkt bekannte Image-IDs (falls die Decal-ID fehlt oder nicht lesbar ist).
-- Werden von tools/ConvertSprites.luau statt der Umwandlung übernommen.
-- Aufbau: Farbe -> Animation -> { [Bildnummer] = Image-ID }
SpriteAssets.imageOverrides = {
	purple = { run = { [2] = 118243593625693 } },
} :: { [string]: { [string]: { [number]: number } } }

-- Image-IDs (erzeugt von tools/ConvertSprites.luau). Gleicher Aufbau wie SpriteAssets.skins.
local images = require(script.Parent.SpriteImages) :: { skins: { [string]: SkinSprites }?, portraits: { [string]: number }? }

-- Image-ID-Tabelle für eine Farbe (oder nil, solange noch nicht umgewandelt)
local function imageSprites(skin: string): SkinSprites?
	return if images.skins then images.skins[skin] else nil
end

-- Bild-ID für ein Frame; fehlt es, das nächstbeste (anderes Frame derselben Animation, sonst idle)
function SpriteAssets.frame(skin: string, animation: string, index: number): string?
	local sprites = imageSprites(skin)
	if not sprites then
		return nil
	end
	local function pick(frames: { number }?, preferred: number): number?
		if not frames or #frames == 0 then
			return nil
		end
		local id = frames[((preferred - 1) % #frames) + 1]
		if id ~= 0 then
			return id
		end
		for _, other in frames do
			if other ~= 0 then
				return other
			end
		end
		return nil
	end
	local id = pick(sprites[animation], index) or pick(sprites.idle, index) or pick(sprites.jump, 1)
	return if id then `rbxassetid://{id}` else nil
end

function SpriteAssets.frameCount(skin: string, animation: string): number
	local sprites = SpriteAssets.skins[skin]
	local frames = sprites and sprites[animation]
	return if frames then #frames else 1
end

-- Sind die Image-IDs schon erzeugt?
function SpriteAssets.hasImages(): boolean
	return images.skins ~= nil and next(images.skins) ~= nil
end

-- Alle Image-IDs (für Vorladen und Prüfen)
function SpriteAssets.allIds(): { { skin: string, animation: string, index: number, id: number } }
	local list = {}
	for skin, sprites in images.skins or {} do
		for animation, frames in sprites do
			for index, id in frames do
				table.insert(list, { skin = skin, animation = animation, index = index, id = id })
			end
		end
	end
	return list
end

return SpriteAssets
